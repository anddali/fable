# ---- Core -------------------------------------------------------------
RAG_ENVIRONMENT=dev                # dev | staging | prod
RAG_LOG_LEVEL=INFO
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
RAG_BLOB_DIR=var/blobs
RAG_CACHE_DIR=var/cache

# ---- Auth (Microsoft Entra ID) -----------------------------------------
# mode=disabled injects a local dev admin; FORBIDDEN when RAG_ENVIRONMENT=prod.
RAG_AUTH__MODE=disabled
RAG_AUTH__TENANT_ID=00000000-0000-0000-0000-000000000000
# Client id (or Application ID URI) of the API app registration.
RAG_AUTH__AUDIENCE=api://rag-platform
# SPA app registration used by the management UI (/ui) for PKCE sign-in.
RAG_AUTH__SPA_CLIENT_ID=
# Role for authenticated users with no Entra app role ("" = deny them).
RAG_AUTH__DEFAULT_ROLE=user

# ---- Embeddings ---------------------------------------------------------
# "fake" = deterministic local vectors (dev only). "openai" = any
# OpenAI-compatible endpoint; configure via RAG_EMBEDDING__CONFIG JSON.
RAG_EMBEDDING__PLUGIN=fake
RAG_EMBEDDING__DIM=1536
# RAG_EMBEDDING__PLUGIN=openai
# RAG_EMBEDDING__CONFIG={"model": "text-embedding-3-small", "api_key_env": "OPENAI_API_KEY"}
# OPENAI_API_KEY=sk-...

# ---- Confluence: platform-wide service account (the "default" connection) --
# Configure once here; users then add sources by pasting a page/space URL —
# no per-source credentials. The token itself lives in the env var named below.
# RAG_CONFLUENCE__BASE_URL=https://yourorg.atlassian.net/wiki
# RAG_CONFLUENCE__USER_EMAIL=service-account@yourorg.com
# RAG_CONFLUENCE__API_TOKEN_ENV=CONFLUENCE_API_TOKEN

# ---- Connector secrets (referenced by name from source/connection config) ---
# CONFLUENCE_API_TOKEN=
# SHAREPOINT_CLIENT_SECRET=
# SLACK_BOT_TOKEN=xoxb-...
# GIT_TOKEN=
